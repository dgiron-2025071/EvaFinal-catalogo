                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('prestamoId', b.id);",
                  "pm.test('Estado ACTIVO', () => pm.expect(b.estado).to.eql('ACTIVO'));",
                  "pm.test('Plazo de 14 dias', () => pm.expect(b.fechaDevolucionEsperada).to.not.be.null);"
                ],
                "type": "text/javascript"
              }
            }

            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"978-{{$guid}}\",\n  \"titulo\": \"Libro de prueba {{$guid}}\",\n  \"autor\": \"Autor Prueba\",\n  \"categoria\": \"Pruebas\",\n  \"stockTotal\": 3\n}"
